// E-Commerce Store Logic: Fraud Check & Inventory Pipeline
// Uses JS SDK connector workers for all business logic

team fraud_guard   : Command<Judge> [size=1, connector="node fraud_engine.js"];
team inventory_sys : Command<Try>   [size=1, connector="node inventory_worker.js"];
team store_ops     : Command<Communicate> [size=1];

policy strict_commerce {
    rules: ["AuditTrail", "Deterministic"];
}

flow process_order(using: fraud_guard, inventory_sys, store_ops) {

    // Step 1: Fraud Check
    checkpoint "risk_analysis" (report: fraud_result) {
        fraud_result = fraud_guard.judge("Evaluate order fraud risk");

        if (fraud_result.pass == false) {
            flow.end;
        }
    }

    // Step 2: Inventory Reservation
    checkpoint "stock_check" (report: inventory_status) {
        inventory_status = inventory_sys.try("reserve");

        if (inventory_status.success == false) {
            flow.end;
        }
    }

    // Step 3: Fulfillment
    checkpoint "fulfillment" (report: final_status) {
        final_status = store_ops.ask("Generate shipping manifest and tracking number");
    }
}
