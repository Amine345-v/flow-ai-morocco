// ============================================================================
// FlowLang — Accountant ERP Software Factory
// ============================================================================

team financial_architects : Command<Search>      [size=3, distribution=round_robin];
team ledger_engineers     : Command<Try>         [size=5, distribution=round_robin];
team compliance_auditors  : Command<Judge>       [size=3, distribution=round_robin];
team ui_designers         : Command<Communicate> [size=2, distribution=round_robin];

flow accounting_erp_system(using: financial_architects, ledger_engineers, compliance_auditors, ui_designers) {
  context retention: checkpoint;
  merge_policy: deep_merge;

  checkpoint "discovery_and_coa_setup" (report: coa_spec) {
    coa_spec = financial_architects.search("define chart of accounts structure: assets, liabilities, equity, revenue, expenses");
    context.update(coa_spec);
  }

  checkpoint "double_entry_ledger_synthesis" (report: ledger_code) {
    ledger_code = ledger_engineers.try("synthesize double-entry general ledger with debit credit balance validation");
    invoicing_code = ledger_engineers.try("build invoicing module with VAT calculation and payment tracking");
    context.update(ledger_code, invoicing_code);
  }

  checkpoint "financial_statement_audit" (report: audit_report) {
    audit_report = compliance_auditors.judge("audit income statement balance sheet and trial balance correctness");
    context.update(audit_report);
  }

  checkpoint "production_app_export" (report: erp_app) {
    erp_app = ui_designers.ask("export complete React Accountant ERP application to JOL Studio workspace");
    context.update(erp_app);
  }
}
